# Copy to .env (same folder; never committed). Only the providers you use need a key.
# Values here are read by `clicky` directly; they are not exported to other programs.

# --- paid providers
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# OPENAI_BASE_URL=              # any OpenAI-compatible endpoint
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=

# --- orchestrator
# CLICKY_PROFILE=local          # local | cloud | hybrid | fake
# CLICKY_PORT=8765
# CLICKY_AUTH_TOKEN=            # fixed pairing token (otherwise generated into .clicky/auth_token)
# CLICKY_ALLOWED_EXTENSION_IDS= # comma-separated; empty = the pinned dev ID
# CLICKY_LOG_LEVEL=INFO
